<view class="container">

  <view class="header-row" style="display: flex; justify-content: space-between; align-items: flex-start; padding: 10px 24px 0;">
    <view class="header-left">
      <view style="display: flex; align-items: center;">
        <view class="title" style="font-size: 24px; font-weight: 800; color: #333;">My Day</view>
        <view class="ghost-help-btn" bindtap="goToHelp">
           <text class="ghost-help-text">ⓘ</text>
        </view>
      </view>
      <view class="subtitle" style="font-size: 13px; color: #999; margin-top: 4px;">Make every hour planned and recorded</view>
    </view>
    
    </view>

  <view class="calendar-header" style="padding-top: 15px;"> <view class="month-title" style="font-size: 20px;">{{monthStr}}</view>
    
    <view class="ctrl-btns">
      <view class="btn" bindtap="prevMonth">‹</view>
      <view class="btn" bindtap="nextMonth">›</view>
      <view class="add-btn-mini" bindtap="goToAdd">+</view>
    </view>
  </view>

  <view class="calendar-wrapper">
    <view class="week-row">
      <view class="week-cell">Mon</view>
      <view class="week-cell">Tue</view>
      <view class="week-cell">Wed</view>
      <view class="week-cell">Thu</view>
      <view class="week-cell">Fri</view>
      <view class="week-cell">Sat</view>
      <view class="week-cell">Sun</view>
    </view>
    <view class="days-grid">
      <block wx:for="{{calendarDays}}" wx:key="index">
        <view class="day-cell {{item.fullDate === selectedDate ? 'selected' : ''}}" 
              bindtap="selectDay" data-date="{{item.fullDate}}">
          <text wx:if="{{!item.empty}}">{{item.day}}</text>
          <view class="dots-row">
            <view wx:for="{{item.dots}}" wx:key="*this" class="dot" style="background: {{item}};"></view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <scroll-view scroll-y class="timeline-container" scroll-top="400">
    <view class="timeline-body {{activePlanId ? 'dim-mode' : ''}}">
      
      <block wx:for="{{timeSlots}}" wx:key="index">
        
        <view class="time-row" bindtap="onPasteTimeSlot" data-time="{{item.full}}">
          <text class="time-label">{{item.label}}</text>
          <view class="time-line"></view>
        </view>
        
        <view class="time-row-half" bindtap="onPasteTimeSlot" data-time="{{item.half}}">
          <view class="time-line-dotted"></view>
        </view>
      
      </block>

      <block wx:for="{{timelinePlans}}" wx:key="id">
        <view class="plan-block {{activePlanId === item.id ? 'active-mode' : ''}} {{isDragging && dragTargetId === item.id ? 'dragging' : ''}}" 
              style="{{item.style}}" 
              catchtap="handlePlanTap" 
              catchlongpress="handlePlanLongPress"
              data-id="{{item.id}}">
          
          <view wx:if="{{activePlanId === item.id}}"
                class="drag-handle top" 
                catchtouchstart="onDragStart" 
                catchtouchmove="onDragMove" 
                catchtouchend="onDragEnd"
                data-id="{{item.id}}" 
                data-type="top"></view>

          <view class="block-content">
            <view class="block-title">
              <text style="margin-right:4px;" wx:if="{{item.icon}}">{{item.icon}}</text>{{item.title}}
            </view>
            <view class="block-time">{{item.startTime}} - {{item.endTime}}</view>
          </view>

          <view wx:if="{{activePlanId === item.id}}"
                class="drag-handle bottom" 
                catchtouchstart="onDragStart" 
                catchtouchmove="onDragMove" 
                catchtouchend="onDragEnd" 
                data-id="{{item.id}}" 
                data-type="bottom"></view>

        </view>
      </block>
    </view>
  </scroll-view>
</view>