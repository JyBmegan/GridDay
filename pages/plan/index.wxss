/* pages/plan/index.wxss */
.container { padding: 0; background: #FAFBFC; height: 100vh; display: flex; flex-direction: column; }

/* 日历样式 */
.calendar-header { padding: 10px 24px; display: flex; justify-content: space-between; align-items: center; background: #fff; z-index: 10; }
.month-title { font-size: 20px; font-weight: 800; color: #333; }
.ctrl-btns { display: flex; gap: 12px; align-items: center; }
.btn { width: 32px; height: 32px; background: #eeeff2; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; color: #666; margin-top: 5px;}
.add-btn-mini { width: 32px; height: 32px; background: #333; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 20px; font-weight: bold; margin-top: 2px;}

.calendar-wrapper { background: #fff; padding: 0 10px 15px; border-radius: 0 0 25px 25px; box-shadow: 0 6px 10px rgba(0,0,0,0.02); z-index: 9; }
.week-row { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 5px; }
.week-cell { text-align: center; font-size: 11px; color: #5d5d5d; font-weight: 600; text-transform: uppercase; }

.days-grid { display: grid; grid-template-columns: repeat(7, 1fr); row-gap: 4px; }
.day-cell { height: 40px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 10px; border-radius: 15px; font-size: 15px; color: #333; border: 1px solid transparent; }
.day-cell.selected { background: #333; color: #fff; font-weight: bold; }

.dots-row { display: flex; gap: 2px; margin-top: 3px; }
.dot { width: 4px; height: 4px; border-radius: 50%; }

.timeline-container { flex: 1; width: 100%;background: #fff; margin-top: 20px; border-radius: 20px 20px 0 0; }
.timeline-body { position: relative; height: 1250px; /* 增加高度防止底部截断 24*50=1200 + padding */ width: 100%; padding: 20px 0; }

.time-row { 
  height: 25px; 
  display: flex; align-items: flex-start; position: relative; 
  box-sizing: border-box;
}
.time-row-half { 
  height: 25px; 
  display: flex; align-items: flex-start; position: relative;
  padding-left: 50px; 
  box-sizing: border-box;
}

.time-label { width: 50px; text-align: center; font-size: 10px; color: #5d5d5d; transform: translateY(-6px); }
.time-line { flex: 1; height: 1px; background: #efeeee; margin-right: 15px; }
.time-line-dotted { width: 100%; height: 1px; border-top: 1px dashed #f5f5f5; margin-right: 15px; }

.plan-block { 
  position: absolute; left: 50px; right: 15px; 
  border-radius: 6px; overflow: hidden; /* 防止内容溢出 */
  font-size: 13px; padding: 6px 8px; 
  display: flex; flex-direction: column; justify-content: flex-start; 
  z-index: 5; box-shadow: 0 3px 6px rgba(0,0,0,0.03); 
  box-sizing: border-box; margin-top: 20px;
  transition: box-shadow 0.1s;
}

.plan-block.dragging {
  box-shadow: 0 10px 20px rgba(0,0,0,0.15);
  opacity: 0.9;
}

.block-title { font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; line-height: 1.2; pointer-events: none; }
.block-time { font-size: 10px; opacity: 0.9; margin-top: 2px; pointer-events: none; }

/* ★★★ 拖拽手柄样式 ★★★ */
.drag-handle {
  position: absolute;
  left: 0; right: 0;
  height: 15px; 
  z-index: 10;
  /* background: rgba(255,0,0,0.2);  */ 
}

.drag-handle.top {
  top: 0;
  cursor: ns-resize;
}

.drag-handle.top::after {
  content: ''; position: absolute; top: 3px; left: 50%; transform: translateX(-50%);
  width: 20px; height: 3px; background: rgba(0,0,0,0.1); border-radius: 2px;
}

.drag-handle.bottom {
  bottom: 0;
  cursor: ns-resize;
}

.drag-handle.bottom::after {
  content: ''; position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%);
  width: 20px; height: 3px; background: rgba(0,0,0,0.1); border-radius: 2px;
}