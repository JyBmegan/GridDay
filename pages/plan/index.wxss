.container { padding: 0; background: #FAFBFC; height: 100vh; display: flex; flex-direction: column; }

/* 日历样式保持不变 */
.calendar-header { padding: 10px 24px; display: flex; justify-content: space-between; align-items: center; background: #fff; z-index: 10; }
.month-title { font-size: 20px; font-weight: 800; color: #333; }
.ctrl-btns { display: flex; gap: 12px; align-items: center; }
.btn { width: 32px; height: 32px; background: #f5f6fa; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; color: #666; }
.add-btn-mini { width: 32px; height: 32px; background: #333; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 20px; font-weight: bold; }
.calendar-wrapper { background: #fff; padding: 0 10px 15px; border-radius: 0 0 20px 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.02); z-index: 9; }
.week-row { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 5px; }
.week-cell { text-align: center; font-size: 11px; color: #ccc; font-weight: 600; text-transform: uppercase; }
.days-grid { display: grid; grid-template-columns: repeat(7, 1fr); row-gap: 4px; }
.day-cell { height: 40px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 4px; border-radius: 8px; font-size: 14px; color: #333; border: 1px solid transparent; }
.day-cell.selected { background: #333; color: #fff; font-weight: bold; }
.dots-row { display: flex; gap: 2px; margin-top: 2px; }
.dot { width: 4px; height: 4px; border-radius: 50%; }
.stats-bar { margin: 15px 20px 0; background: #fff; padding: 12px 16px; border-radius: 16px; display: flex; gap: 20px; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.02); }
.total-box { display: flex; flex-direction: column; align-items: center; min-width: 50px; border-right: 1px solid #eee; padding-right: 15px; }
.total-box .num { font-size: 20px; font-weight: 800; color: #333; }
.total-box .unit { font-size: 10px; color: #999; }
.dist-box { flex: 1; overflow: hidden; }
.dist-row { height: 6px; width: 100%; display: flex; border-radius: 3px; overflow: hidden; margin-bottom: 6px; }
.dist-item { height: 100%; }
.dist-labels { display: flex; white-space: nowrap; gap: 12px; width: 100%; }
.label-item { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; color: #666; }
.label-item .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }

.timeline-container { flex: 1; position: relative; background: #fff; margin-top: 10px; border-radius: 20px 20px 0 0; }
.timeline-body { position: relative; height: 1200px; width: 100%; padding: 10px 0; }

/* ★★★ Grid Alignment Fix ★★★ */
.time-row { 
  height: 25px; /* First half hour (total 50px) */
  display: flex; align-items: flex-start; position: relative; 
  box-sizing: border-box;
}
.time-row-half { 
  height: 25px; /* Second half hour */
  display: flex; align-items: flex-start; position: relative;
  padding-left: 50px; 
  box-sizing: border-box;
}

.time-label { width: 50px; text-align: center; font-size: 10px; color: #b2bec3; transform: translateY(-6px); }
.time-line { flex: 1; height: 1px; background: #f0f0f0; margin-right: 15px; }
.time-line-dotted { width: 100%; height: 1px; border-top: 1px dashed #f5f5f5; margin-right: 15px; }

.plan-block { 
  position: absolute; left: 50px; right: 15px; 
  border-radius: 6px; overflow: hidden; 
  font-size: 11px; padding: 2px 6px; 
  display: flex; flex-direction: column; justify-content: flex-start; padding-top: 4px;
  z-index: 5; box-shadow: 0 2px 5px rgba(0,0,0,0.03); 
  box-sizing: border-box; /* 关键：防止边框增加高度 */
}
.block-title { font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; line-height: 1.2; }
.block-time { font-size: 9px; opacity: 0.8; margin-top: 1px; }