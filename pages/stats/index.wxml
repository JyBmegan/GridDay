<view class="container">
  
  <view class="type-switch-header">
    <view class="type-btn {{statType === 'habit' ? 'active' : ''}}" bindtap="switchStatType" data-type="habit">Habits</view>
    <view class="type-btn {{statType === 'plan' ? 'active' : ''}}" bindtap="switchStatType" data-type="plan">Plans</view>
  </view>

  <block wx:if="{{statType === 'habit'}}">
    
    <view class="header-row" style="display: flex; justify-content: space-between; align-items: flex-start; padding: 10px 20px;">
        <view class="header-left">
            <view style="display: flex; align-items: center;">
                <view class="title" style="font-size: 24px; font-weight: 800; color: #333;">Tracker Analytics</view>
                <view class="ghost-help-btn" bindtap="goToHelp">
                    <text class="ghost-help-text">ⓘ</text>
                </view>
            </view>
            <view class="subtitle" style="font-size: 13px; color: #999; margin-top: 4px;">Review your habit cultivation</view>
        </view>
    </view>

    <view class="header-row">
       <view class="range-nav-bar compact">
          <view class="nav-btn" bindtap="prevRange" style="opacity: {{currentView==='all'?0:1}}">‹</view>
          <view class="nav-text">{{dateRangeStr}}</view>
          <view class="nav-btn" bindtap="nextRange" style="opacity: {{currentView==='all'?0:1}}">›</view>
       </view>
       
       <view class="filter-trigger" catchtap="toggleDropdown" wx:if="{{categories.length > 0}}">
            <text class="filter-text">{{currentCategory}}</text>
            <view class="arrow-icon">▼</view>
       </view>
    </view>

    <view class="dropdown-menu {{showDropdown ? 'show' : ''}}" catchtap="stopProp">
        <view class="dropdown-item" bindtap="switchCategory" data-cat="All">All</view>
        <block wx:for="{{categories}}" wx:key="*this">
            <view class="dropdown-item" bindtap="switchCategory" data-cat="{{item}}">{{item}}</view>
        </block>
    </view>

    <view class="mode-switch-container">
        <view class="mode-switch-box">
          <view class="mode-btn {{displayMode === 'trend' ? 'active' : ''}}" bindtap="switchDisplayMode" data-mode="trend">Trend</view>
          <view class="mode-btn {{displayMode === 'time' ? 'active' : ''}}" bindtap="switchDisplayMode" data-mode="time">Hours</view>
        </view>
    </view>

    <view class="tabs-wrapper">
        <view class="tabs-box">
          <view class="tab {{currentView === 'week' ? 'active' : ''}}" bindtap="switchView" data-view="week">Week</view>
          <view class="tab {{currentView === 'month' ? 'active' : ''}}" bindtap="switchView" data-view="month">Month</view>
          <view class="tab {{currentView === 'year' ? 'active' : ''}}" bindtap="switchView" data-view="year">Year</view>
          <view class="tab {{currentView === 'all' ? 'active' : ''}}" bindtap="switchView" data-view="all">All</view>
        </view>
    </view>

    <scroll-view scroll-y class="grid-scroll">
        <view class="stats-grid">
          <block wx:for="{{filteredHabits}}" wx:key="id" wx:for-item="habit">
            <view class="stat-card" bindtap="goToDetail" data-id="{{habit.id}}">
                <view class="card-header">
                  <view class="icon-box" style="background: {{habit.color}}15; display: flex; align-items: center; justify-content: center;">
                    <image wx:if="{{habit.icon.length > 10}}" src="{{habit.icon}}" style="width: 20px; height: 20px; border-radius: 4px;" />
                    <text wx:else>{{habit.icon}}</text>
                  </view>
                    <view class="name-box">
                        <view class="name">{{habit.name}}</view>
                        <view class="count-text" style="color: '#5d5d5d'">
                            {{habit.displayTotal}}
                            <text class="unit-text"> times</text>
                        </view>
                    </view>
                </view>
                <view class="chart-area">
                    <block wx:if="{{displayMode === 'trend'}}">
                      <view class="chart-week" wx:if="{{currentView === 'week'}}">
                        <block wx:for="{{habit.weekData}}" wx:key="date" wx:for-item="day">
                          <view class="week-col">
                            <view class="bar-track">
                              <view class="bar-active" style = "height: {{day.heightPct}}%; background: {{day.count > 0 ? habit.color : '#e0e0e0'}}"></view>
                            </view>
                            <text class="day-label">{{day.weekDay}}</text>
                          </view>
                        </block>
                      </view>
                        
                        <view class="chart-month" wx:if="{{currentView === 'month'}}">
                            <block wx:for="{{habit.monthData}}" wx:key="date" wx:for-item="day">
                              <view class="month-pixel" style="background: {{day.isEmpty ? '#ebedf0' : habit.color}}; opacity: {{day.opacity}}">
                                <text class="month-date-num" style="color: {{day.isEmpty ? '#ccc' : '#fff'}}">{{day.dayNum}}</text>
                              </view>
                            </block>
                        </view>
                        
                        <view class="chart-year" wx:if="{{currentView === 'year'}}">
                            <block wx:for="{{habit.yearData}}" wx:key="month" wx:for-item="m">
                                <view class="year-block" style="background: {{m.isEmpty ? '#ebedf0' : habit.color}}; opacity: {{m.opacity}}">
                                    <text class="year-month-num" style="color:{{m.isEmpty ? '#ccc' : '#fff'}}">{{index+1}}</text>
                                </view>
                            </block>
                        </view>

                        <view class="chart-all" wx:if="{{currentView === 'all'}}" style="height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-bottom: 20px;">
                             <view style="font-size: 56px; font-weight: 800; color: {{habit.color}}; line-height: 1;">
                                {{habit.displayTotal}}
                             </view>
                             <view style="font-size: 13px; color: #999; font-weight: 600; margin-top: 4px; letter-spacing: 1px; text-transform: uppercase;">
                                Total Check-ins
                             </view>
                        </view>
                    </block>
                    
                    <block wx:if="{{displayMode === 'time'}}">
                        <view class="chart-time-curve">
                            <ec-canvas id="chart-time-{{habit.id}}" canvas-id="chart-time-{{habit.id}}" ec="{{ habit.ec }}" force-use-old-canvas="false"></ec-canvas>
                        </view>
                    </block>
                </view>
            </view>
          </block>
        </view>
        <view style="height: 40px;"></view>
    </scroll-view>
  </block>


  <block wx:if="{{statType === 'plan'}}">
    
    <view class="header-row" style="display: flex; justify-content: space-between; align-items: flex-start; padding: 10px 20px;">
        <view class="header-left">
            <view style="display: flex; align-items: center;">
                <view class="title" style="font-size: 24px; font-weight: 800; color: #333;">Schedules Analytics</view>
                <view class="ghost-help-btn" bindtap="goToHelp">
                    <text class="ghost-help-text">ⓘ</text>
                </view>
            </view>
            <view class="subtitle" style="font-size: 13px; color: #999; margin-top: 4px;">Review your efficiency</view>
        </view>
    </view>

    <view class="header-row">
       <view class="range-nav-bar compact">
          <view class="nav-btn" bindtap="prevRange" style="opacity: {{currentView==='all'?0:1}}">‹</view>
          <view class="nav-text">{{dateRangeStr}}</view>
          <view class="nav-btn" bindtap="nextRange" style="opacity: {{currentView==='all'?0:1}}">›</view>
       </view>
       
       <view class="filter-trigger" catchtap="togglePlanDropdown">
           <text class="filter-text">{{currentPlanCategory}}</text>
           <view class="arrow-icon">▼</view>
       </view>
    </view>

    <view class="dropdown-menu {{showPlanDropdown ? 'show' : ''}}" catchtap="stopProp">
        <view class="dropdown-item" bindtap="switchPlanCategory" data-cat="All">All</view>
        <block wx:for="{{planFilterCats}}" wx:key="*this">
           <view class="dropdown-item" bindtap="switchPlanCategory" data-cat="{{item}}">{{item}}</view>
        </block>
    </view>

    <view class="tabs-wrapper">
        <view class="tabs-box">
          <view class="tab {{currentView === 'week' ? 'active' : ''}}" bindtap="switchView" data-view="week">Week</view>
          <view class="tab {{currentView === 'month' ? 'active' : ''}}" bindtap="switchView" data-view="month">Month</view>
          <view class="tab {{currentView === 'year' ? 'active' : ''}}" bindtap="switchView" data-view="year">Year</view>
          <view class="tab {{currentView === 'all' ? 'active' : ''}}" bindtap="switchView" data-view="all">All</view>
        </view>
    </view>

    <scroll-view scroll-y class="grid-scroll">
       <view class="stat-card">
          <view class="card-header"><view class="name-box"><view class="name">Intensity Map</view></view></view>
          <scroll-view scroll-x class="year-scroll-box" wx:if="{{isYearView}}" enable-flex="true">
             <view class="heatmap-grid-year-gh">
                <block wx:for="{{heatmapGrid}}" wx:key="index">
                   <view class="viz-block-year" style="background: {{item.color}}; opacity: {{item.opacity}}"></view>
                </block>
             </view>
          </scroll-view>
          <view class="intensity-row" wx:else>
             <view class="intensity-chart">
                <view class="heatmap-grid-normal">
                   <block wx:for="{{heatmapGrid}}" wx:key="index">
                      <view class="viz-block {{item.empty?'empty':''}}" style="background: {{item.color}}; opacity: {{item.opacity}}"></view>
                   </block>
                </view>
             </view>
             <view class="intensity-data">
                <view class="data-item-sm"><text class="d-label-sm">{{footerData.heatmap.label1}}</text><text class="d-val-sm">{{footerData.heatmap.val1}}</text></view>
                <view class="data-item-sm" style="margin-top:15px"><text class="d-label-sm">{{footerData.heatmap.label2}}</text><text class="d-val-sm">{{footerData.heatmap.val2}}</text></view>
             </view>
          </view>
          <view class="data-footer" wx:if="{{isYearView}}">
             <view class="data-item"><text class="d-label">{{footerData.heatmap.label1}}</text><text class="d-val">{{footerData.heatmap.val1}}</text></view>
             <view class="data-item"><text class="d-label">{{footerData.heatmap.label2}}</text><text class="d-val">{{footerData.heatmap.val2}}</text></view>
          </view>
       </view>

       <view class="stat-card">
          <view class="card-header"><view class="name-box"><view class="name">Trends</view></view></view>
          <view class="chart-container" style="height: {{trendHeight}}px;">
             <ec-canvas id="chart-plan-bar" canvas-id="chart-plan-bar" ec="{{ ecStackBar }}" force-use-old-canvas="false"></ec-canvas>
          </view>
          <view class="data-footer">
             <view class="data-item"><text class="d-label">{{footerData.trend.label1}}</text><text class="d-val">{{footerData.trend.val1}}</text></view>
             <view class="data-item"><text class="d-label">{{footerData.trend.label2}}</text><text class="d-val">{{footerData.trend.val2}}</text></view>
          </view>
       </view>

       <view class="stat-card" style="height: auto;">
          <view class="card-header"><view class="name-box"><view class="name">Distribution</view></view></view>
          <view class="dist-layout-col">
             <view class="chart-container" style="height: 200px; width: 100%;">
                <ec-canvas id="chart-plan-pie" canvas-id="chart-plan-pie" ec="{{ ecPie }}" force-use-old-canvas="false"></ec-canvas>
             </view>
             <view class="legend-list">
                <block wx:for="{{planCategories}}" wx:key="name">
                   <view class="legend-item">
                      <view class="legend-left"><view class="legend-dot" style="background: {{item.color}}"></view><text class="legend-name">{{item.name}}</text></view>
                      <view class="legend-right"><text class="legend-hours">{{item.hours}}h</text><text class="legend-percent">{{item.percent}}%</text></view>
                   </view>
                </block>
             </view>
          </view>
          <view class="data-footer">
             <view class="data-item"><text class="d-label">{{footerData.dist.label1}}</text><text class="d-val">{{footerData.dist.val1}}</text></view>
             <view class="data-item"><text class="d-label">{{footerData.dist.label2}}</text><text class="d-val">{{footerData.dist.val2}}</text></view>
          </view>
       </view>

       <view class="stat-card">
          <view class="card-header"><view class="name-box"><view class="name">Hourly Focus</view></view></view>
          <view class="chart-container" style="height: 150px;">
             <ec-canvas id="chart-plan-curve" canvas-id="chart-plan-curve" ec="{{ ecLine }}" force-use-old-canvas="false"></ec-canvas>
          </view>
          <view class="data-footer">
             <view class="data-item"><text class="d-label">{{footerData.curve.label1}}</text><text class="d-val">{{footerData.curve.val1}}</text></view>
             <view class="data-item"><text class="d-label">{{footerData.curve.label2}}</text><text class="d-val">{{footerData.curve.val2}}</text></view>
          </view>
       </view>
       
       <view style="height: 40px;"></view>
    </scroll-view>
  </block>
</view>