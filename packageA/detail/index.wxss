.container { padding: 24px 20px; min-height: 100vh; background-color: #FAFBFC; }

/* 头部 */
.header-simple { display: flex; flex-direction: column; align-items: center; margin-bottom: 24px; }
.big-icon { font-size: 44px; margin-bottom: 8px; }
.big-name { font-size: 20px; font-weight: 800; color: #2D3436; }

/* 通用卡片 */
.card {
  background: white; border-radius: 24px; padding: 24px; margin-bottom: 20px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.02);
}
.card-header { margin-bottom: 20px; }
.card-title { font-size: 18px; font-weight: 800; color: #333; }

/* This Week 图表 */
.chart-container { 
  width: 100%; 
  height: 220px; 
  margin-bottom: 10px;
}

/* This Week 底部四格数据 */
.stats-grid { display: flex; justify-content: space-between; border-top: 2px solid #f5f6fa; padding-top: 18px; }
.stat-box { display: flex; flex-direction: column; align-items: center; flex: 1; }
.label { font-size: 12px; color: #5d5d5d; margin-bottom: 7px; }
.value { font-size: 18px; font-weight: 800; color: #333; }

/* 日历 */
.calendar-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 12px; }
.weekday { text-align: center; font-size: 12px; color: #5d5d5d; }

.calendar-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
.day { height: 36px; display: flex; align-items: center; justify-content: center; }
.day-num { 
  width: 32px; height: 32px; border-radius: 50%; 
  display: flex; align-items: center; justify-content: center; 
  font-size: 14px; color: #333; border: 2px solid transparent;
}
/* 完成状态：实心背景 */
.day-num.done { color: white; font-weight: bold; }

/* 列表 */
.history-list { display: flex; flex-direction: column; gap: 16px; }
.log-item { display: flex; align-items: center; }
.log-left { width: 50px; text-align: right; margin-right: 12px; }
.log-date { font-size: 10px; color: #999; }
.log-time { font-size: 16px; font-weight: bold; color: #333; font-family: monospace; }
.log-line { width: 2px; height: 32px; background: #f0f2f5; margin-right: 12px; border-radius: 1px; }
.log-content { flex: 1; background: #f8f9fa; padding: 10px 14px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center; }
.log-note { font-size: 14px; color: #333; }
.log-tag { font-size: 10px; padding: 2px 6px; border-radius: 6px; border: 1px solid; }

.empty-logs { text-align: center; color: #ccc; padding: 20px 0; font-size: 12px; }
.delete-zone { text-align: center; color: #ff6b6b; font-size: 14px; margin-top: 40px; padding-bottom: 30px; opacity: 0.6; }