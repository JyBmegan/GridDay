.color-list-inline {
  display: grid;
  grid-template-columns: repeat(9, 1fr); 
  gap: 10px; 
  padding: 5px; 
  max-height: 180px; 
  overflow-y: auto;
}

.color-item-inline {
  width: 100%;           
  aspect-ratio: 1 / 1; 
  border-radius: 50%;
  position: relative; 
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  border: 1px solid rgba(0,0,0,0.05); 
}

.check-mark {
  position: absolute;
  top: 0; left: 0; 
  width: 100%; height: 100%;
  display: flex; 
  align-items: center; 
  justify-content: center;
  color: white; 
  font-size: 12px; 
  font-weight: bold;
}


.draw-btn {
  border: 2px dashed #ccc !important;
  color: #999;
  font-weight: bold;
  background: #f9f9f9 !important;
}

/* Footer */
.footer { position: fixed; bottom: 40px; left: 0; width: 100%; padding: 0 24px; box-sizing: border-box; z-index: 10; }
.save-btn { width: 100%; height: 56px; border-radius: 28px; color: white; font-size: 18px; font-weight: bold; display: flex; align-items: center; justify-content: center; }

/* Modal */
.color-modal { position: fixed; bottom: 0; left: 0; width: 100%; z-index: 999; visibility: hidden; }
.color-modal.show { visibility: visible; }
.modal-mask { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.3); opacity: 0; transition: opacity 0.3s; }
.color-modal.show .modal-mask { opacity: 1; bottom: 100vh; top: -100vh; } 
.modal-content { position: absolute; bottom: 0; width: 100%; background: #fff; border-radius: 24px 24px 0 0; padding: 30px 24px; padding-bottom: 50px; transform: translateY(100%); transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); z-index: 2; }
.color-modal.show .modal-content { transform: translateY(0); }
.modal-title { text-align: center; font-size: 16px; font-weight: bold; margin-bottom: 20px; color: #333; }
.color-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 15px; }
.color-circle { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.check { color: white; font-weight: bold; font-size: 14px; }

/* plan项目联想框 */
.suggestion-box {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: white;
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  max-height: 200px;
  overflow-y: auto;
  z-index: 999;
  border: 1px solid #f0f0f0;
  margin-top: 5px;
}

.suggestion-item:active {
  background-color: #f5f5f5;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-item {
  display: flex; 
  justify-content: space-between;
  align-items: center;
  padding: 0; 
  border-bottom: 1px solid #f9f9f9;
}

.suggestion-text {
  flex: 1;
  padding: 12px 16px;
  font-size: 14px;
  color: #333;
}

.suggestion-del {
  padding: 12px 16px;
  color: #ccc;
  font-size: 14px;
  font-weight: bold;
}
.suggestion-del:active {
  color: #ff6b6b; 
  background-color: #f0f0f0;
}