.container { 
  padding: 30px 24px; 
  min-height: 100vh; 
  background: #FAFBFC; 
  box-sizing: border-box; 
  padding-bottom: 120px; 
}

.page-title { 
  font-size: 28px; 
  font-weight: 800; 
  color: #333; 
  margin-bottom: 30px; 
}

.main-input { 
  font-size: 20px; 
  font-weight: bold; 
  padding: 20px; 
  background: #fff; 
  border-radius: 20px; 
  height: 60px; 
  margin-bottom: 30px; 
}

.ph { color: #ccc; font-weight: normal; }

.section-title { 
  font-size: 14px; 
  color: #999; 
  margin-bottom: 12px; 
  margin-left: 4px; 
  font-weight: 600; 
}

/* Category */
.category-wrapper { margin-bottom: 30px; }

.category-list { 
  display: flex; 
  flex-wrap: wrap; 
  gap: 10px; 
}

.cat-tag { 
  padding: 8px 16px; 
  background: #fff; 
  border: 1px solid #eee; 
  border-radius: 20px; 
  color: #666; 
  font-size: 14px; 
  transition: all 0.2s; 
}

.cat-tag.active { 
  color: white; 
  border-color: transparent; 
  font-weight: bold; 
  transform: scale(1.05); 
}

.cat-tag.add-btn { 
  color: #999; 
  border-style: dashed; 
  font-weight: bold; 
}

.add-cat-box { 
  margin-top: 10px; 
  display: flex; 
  align-items: center; 
  background: #fff; 
  padding: 0 15px; 
  border-radius: 20px; 
  border: 1px solid #eee; 
  width: 220px; 
}

.cat-input { 
  height: 40px; 
  flex: 1; 
  font-size: 14px; 
}

.cat-confirm { 
  font-size: 14px; 
  font-weight: bold; 
  padding: 10px; 
}

/* Icon */
/* 修改为 8 列紧凑网格 */
.emoji-grid { 
  display: grid; 
  grid-template-columns: repeat(8, 1fr); /* ★ 这里改成 8 列 */
  gap: 6px; /* ★ 缩小间距，更紧凑 */
  max-height: 200px; 
  overflow-y: auto; 
  padding: 5px; 
  margin-bottom: 30px; 
}

.emoji-item { 
  height: 38px;
  display: flex; 
  align-items: center; 
  justify-content: center; 
  font-size: 20px; 
  background: #fff; 
  border-radius: 8px; 
  border: 2px solid transparent; 
  transition: all 0.2s; 
}

.emoji-item.selected { 
  transform: scale(1.05); 
}

.draw-btn {
    border: 2px dashed #ccc !important;
    color: #999 !important;
    font-weight: bold;
    font-size: 22px !important;
    background: #f9f9f9 !important;
}

/* Time Card */
.time-card { 
  background: #fff; 
  border-radius: 20px; 
  padding: 0 20px; 
  margin-bottom: 30px; 
}

.picker-row { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  height: 60px; 
}

.label { 
  font-size: 16px; 
  color: #333; 
  font-weight: 500; 
}

.value { 
  font-size: 16px; 
  color: #333; 
  font-weight: bold; 
  font-family: monospace; 
}

.divider { height: 1px; background: #f5f5f5; }

