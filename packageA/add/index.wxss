
.container { padding: 30px 24px; padding-bottom: 60px; background-color: #FAFBFC; min-height: 100vh; }
.page-title { font-size: 28px; font-weight: 800; margin-bottom: 32px; color: #2D3436; }
.section { margin-bottom: 32px; }
.label { font-size: 16px; color: #636e72; margin-bottom: 12px; font-weight: 600; }
.input-box { background: #fff; padding: 18px; border-radius: 16px; font-size: 16px; }

/* Category */
.category-list { display: flex; flex-wrap: wrap; gap: 10px; }
.cat-item { 
  padding: 8px 16px; border-radius: 20px; font-size: 14px; color: #666; 
  border: 1px solid #eee; background: #fff; transition: all 0.2s;
}
.cat-item.active { color: white; font-weight: bold; }
.cat-item.add-btn { font-weight: bold; color: #999; border-style: dashed; }

.add-cat-box { 
  margin-top: 10px; display: flex; align-items: center; 
  background: #fff; padding: 0 15px; border-radius: 20px; border: 1px solid #eee; width: 220px;
}
.cat-input { height: 40px; flex: 1; font-size: 14px; }
.cat-confirm { font-size: 14px; font-weight: bold; padding: 10px; }

/* Icon */
.emoji-grid { 
  display: grid; 
  grid-template-columns: repeat(6, 1fr); /* 一行放6个 */
  gap: 10px; 
  max-height: 200px; 
  overflow-y: auto; /* 允许上下滚动 */
  padding: 5px;
}

.emoji-item { 
  height: 44px; 
  display: flex; align-items: center; justify-content: center; 
  font-size: 22px; 
  background: #fff; 
  border-radius: 10px; 
  border: 2px solid transparent;
}

/* Color*/
.color-scroll { 
  display: flex; 
  flex-wrap: wrap; 
  gap: 12px; 
}
.color-item { 
  width: 36px; height: 36px; border-radius: 50%; position: relative; 
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}
.check-mark { 
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; 
  display: flex; align-items: center; justify-content: center; 
  color: white; font-weight: bold; font-size: 14px;
}

/* Daily Goal */
.stepper-box { display: flex; align-items: center; background: white; padding: 10px; border-radius: 16px; width: fit-content; }
.stepper-btn { width: 44px; height: 44px; background: #f1f2f6; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold;}
.stepper-num { font-size: 22px; font-weight: bold; width: 50px; text-align: center; }
.unit { font-size: 14px; color: #b2bec3; margin: 0 10px; }

/* Button */
.save-btn { color: white; border-radius: 30px; font-weight: bold; margin-top: 40px; height: 56px; display: flex; align-items: center; justify-content: center; font-size: 18px; }

