<view class="container">
  <view class="page-title">New Habit</view>

  <view class="section">
    <view class="label">Habit Name</view>
    <input 
    class="input-box" 
    value="{{name}}"
    placeholder="e.g., Drink water" placeholder-class="ph-style" bindinput="bindNameInput" />
  </view>

  <view class="section">
    <!-- <view class="label">Category</view> -->
    <view class="label-row" style="display: flex; justify-content: space-between; align-items: baseline;">
      <view class="label">Category</view>
      <view style="font-size: 12px; color: #999;">(Long press tag to delete)</view>
    </view>
    <view class="category-list">
    <view 
      wx:for="{{categoryList}}" wx:key="*this"
      class="cat-item {{category === item ? 'active' : ''}}"
      bindtap="selectCategory" 
      bindlongpress="deleteCategory" 
      data-item="{{item}}"
      style="{{category === item ? 'background:'+selectedColor+'; border-color:'+selectedColor : ''}}"
    >
      {{item}}
      </view>
    <view class="cat-item add-btn" bindtap="toggleAddCategory" wx:if="{{!showAddCategory}}">+</view>
  </view>
    
    <view class="add-cat-box" wx:if="{{showAddCategory}}">
      <input class="cat-input" placeholder="New Category Name" focus="{{true}}" bindinput="bindCategoryInput" />
      <view class="cat-confirm" bindtap="confirmAddCategory" style="color: {{selectedColor}}">Saved</view>
    </view>
  </view>

  <view class="section">
    <view class="label">Icon <text wx:if="{{icon}}" style="font-size:16px; margin-left:10px;">  - Selected: {{icon}}</text></view>
    <view class="emoji-grid">
      <view 
        wx:for="{{emojis}}" 
        wx:key="*this"
        bindtap="selectEmoji"
        data-emoji="{{item}}"
        class="emoji-item {{icon === item ? 'selected' : ''}}"
        style="border-color: {{icon === item ? selectedColor : 'transparent'}}; background: {{icon === item ? selectedColor + '20' : '#fff'}};"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view class="section">
    <view class="label">Color</view>
    <view class="color-scroll">
      <view 
        wx:for="{{colors}}" 
        wx:key="*this" 
        bindtap="selectColor" 
        data-color="{{item}}"
        class="color-item {{selectedColor === item ? 'active' : ''}}" 
        style="background: {{item}};">
        <view wx:if="{{selectedColor === item}}" class="check-mark">✓</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="label">Daily Goal</view>
    <view class="stepper-box">
      <view class="stepper-btn" bindtap="decreaseGoal">-</view>
      <view class="stepper-num" style="color: {{selectedColor}}">{{goal}}</view>
      <view class="stepper-btn" bindtap="increaseGoal">+</view>
      <text class="unit">times daily</text>
    </view>
  </view>

  <button class="save-btn" bindtap="saveHabit" style="background: {{selectedColor}}; box-shadow: 0 8px 20px {{selectedColor}}60;">
    Start Tracking
  </button>
</view>